# TechCorp Customer Success AI Agent - Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================================================
# REQUIRED: OpenAI API Key
# ============================================================================
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================================================
# OPTIONAL: Twilio (WhatsApp Channel)
# ============================================================================
# Get from: https://www.twilio.com
TWILIO_ACCOUNT_SID=AC-your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ============================================================================
# OPTIONAL: Google Cloud (Gmail Channel)
# ============================================================================
# Get from: https://console.cloud.google.com
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CREDENTIALS_PATH=./credentials/google.json

# ============================================================================
# Application Settings (Defaults provided)
# ============================================================================
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO

# Database (Docker Compose default)
DATABASE_URL=postgresql://fte_user:fte_password@postgres:5432/fte_db

# Kafka (Docker Compose default)
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Feature Flags
ENABLE_EMAIL_CHANNEL=true
ENABLE_WHATSAPP_CHANNEL=true
ENABLE_WEB_FORM=true
